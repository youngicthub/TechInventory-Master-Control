# The control-plane database - customers, installations, heartbeats,
# errors. These tables live in their own "master_control" Postgres
# schema (see db/src/schema/pg-schema.ts), so it's SAFE to point this at
# the exact same Neon connection string as the main app's own
# DATABASE_URL - nothing here can collide with the main app's tables. If
# you're only running your own single store (not reselling this to other
# businesses), that's the simplest option: reuse the same DATABASE_URL
# from the repo root .env. If you later onboard other customers with
# their own separate databases, keep those as separate connection
# strings via each customer's own "provision" step - MASTER_DATABASE_URL
# itself never has to change.
MASTER_DATABASE_URL=postgresql://user:password@host/masterdb?sslmode=require

# Signs the Master App's login sessions. Use a DIFFERENT value than the
# main inventory app's JWT_SECRET. Generate with: openssl rand -hex 32
MASTER_JWT_SECRET=

# Encrypts every customer's database connection string before it's stored.
# This is arguably the most important secret in the whole system - it's
# what stands between a leaked master database and every customer's
# entire business data being exposed. Keep it somewhere separate from
# your database backups. Generate with: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=

# One-time key required to create the first Master App admin account
# (you) via POST /api/admin/setup - same "break-glass" reasoning as the
# main app's ADMIN_SETUP_KEY. Generate with: openssl rand -hex 16
MASTER_SETUP_KEY=

# Optional - defaults shown
PORT=4100
# How many seconds without a heartbeat before an installation is shown as
# OFFLINE rather than ONLINE.
MASTER_OFFLINE_THRESHOLD_SECONDS=120

# Which browser origins may call the API (comma-separated). Defaults cover
# the dashboard (4200) and landing page (4300) running locally.
# MASTER_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300
# Bind address. Default 127.0.0.1 = this machine only. Use 0.0.0.0 to serve your LAN / Docker.
# MASTER_HOST=127.0.0.1
# Set to "true" ONLY when running behind a reverse proxy you control.
# MASTER_TRUST_PROXY=false
